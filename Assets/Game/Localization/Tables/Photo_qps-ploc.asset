  m_TableData:
  - m_Id: 728752128
    m_Localized: "\u041E\u041D\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 779083776
    m_Localized: "24 \u0444\u0435\u0432\u0440\u0430\u043B\u044F 2022 \u0433\u043E\u0434\u0430.
      \u0423\u0442\u0440\u043E \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
      \u0441 \u043D\u043E\u0432\u043E\u0441\u0442\u0435\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u043C
      \u043D\u0435 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043C\u0435\u0441\u0442\u0430
      \u0432 \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u043E\u0439 \u0436\u0438\u0437\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 779083777
    m_Localized: "\u0420\u0415\u0414\u0410\u041A\u0422\u041E\u0420"
    m_Metadata:
      m_Items: []
  - m_Id: 779083778
    m_Localized: "\u0410\u0433\u0435\u043D\u0442\u0441\u0442\u0432\u043E \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0440\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 \u043E\u0444\u0438\u0441.
      \u041F\u0440\u043E\u0435\u043A\u0442\u044B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u044B.
      \u041A\u043E\u043C\u0430\u043D\u0434\u0430 \u0440\u0430\u0441\u043F\u0443\u0449\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 779083779
    m_Localized: "\u0422\u0415\u041B\u0415\u0424\u041E\u041D"
    m_Metadata:
      m_Items: []
  - m_Id: 779083780
    m_Localized: "Forbidgram \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D.
      \u041A\u043B\u0438\u0435\u043D\u0442\u044B \u043C\u043E\u043B\u0447\u0430\u0442.
      \u0412 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0435 \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F
      \u0430\u0440\u0445\u0438\u0432, \u043D\u0435\u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0435
      \u0441\u0447\u0435\u0442\u0430 \u0438 \u0431\u0438\u043B\u0435\u0442 \u0432
      \u043E\u0434\u0438\u043D \u043A\u043E\u043D\u0435\u0446."
    m_Metadata:
      m_Items: []
  - m_Id: 779083781
    m_Localized: "\u041E\u041D\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 779083782
    m_Localized: "\u041F\u0435\u0440\u0435\u0434 \u043E\u0442\u044A\u0435\u0437\u0434\u043E\u043C
      \u043D\u0443\u0436\u0435\u043D \u0435\u0449\u0451 \u043E\u0434\u0438\u043D
      \u043A\u0430\u0434\u0440 \u2014 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u0447\u0435\u0441\u0442\u043D\u044B\u0439, \u0447\u0442\u043E\u0431\u044B
      \u043D\u0435 \u043F\u0440\u0435\u0434\u0430\u0442\u044C \u0441\u0435\u0431\u044F,
      \u0438 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0437\u0430\u043C\u0435\u0442\u043D\u044B\u0439,
      \u0447\u0442\u043E\u0431\u044B \u043E\u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10108535824384
    m_Localized: "\u0418\u0441\u0442\u043E\u0440\u0438\u044F \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738944
    m_Localized: "\u041F\u0420\u041E\u041B\u041E\u0413 \u2022 \u0421\u0410\u041D\u041A\u0422-\u041F\u0415\u0422\u0415\u0420\u0411\u0423\u0420\u0413"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738945
    m_Localized: "\u0418\u0421\u0421\u041B\u0415\u0414\u041E\u0412\u0410\u041D\u0418\u0415
      \u2022 \u0414\u0412\u041E\u0420 \u0418 \u041F\u041E\u0427\u0422\u041E\u0412\u042B\u0415
      \u042F\u0429\u0418\u041A\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738946
    m_Localized: "\u041A\u0410\u041C\u0415\u0420\u0410 \u2022 \u0412\u042B\u0411\u041E\u0420
      \u041A\u0410\u0414\u0420\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738947
    m_Localized: "FORBIDGRAM \u2022 \u041F\u0423\u0411\u041B\u0418\u041A\u0410\u0426\u0418\u042F"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738948
    m_Localized: "\u041E\u0422\u0420\u0410\u0416\u0415\u041D\u0418\u0415"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738949
    m_Localized: "\u0414\u0423\u0411\u0410\u0419 \u2022 \u0422\u0420\u0410\u041D\u0417\u0418\u0422\u041D\u0410\u042F
      \u0413\u041E\u0421\u0422\u0418\u041D\u0418\u0426\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738950
    m_Localized: "WHITE-BOX \u0421\u0426\u0415\u041D\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738951
    m_Localized: "\u0412\u0418\u0414\u041E\u0418\u0421\u041A\u0410\u0422\u0415\u041B\u042C"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738952
    m_Localized: "\u0427\u0415\u0421\u0422\u041D\u042B\u0419 \u041A\u0410\u0414\u0420"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738953
    m_Localized: "\u0411\u0415\u0417\u041E\u041F\u0410\u0421\u041D\u042B\u0419 \u041A\u0410\u0414\u0420"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738954
    m_Localized: "WHITE-BOX \u0424\u0418\u041D\u0410\u041B \u041F\u0420\u041E\u041B\u041E\u0413\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738955
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u0435:
      {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738956
    m_Localized: "\u042D\u043A\u0441\u043F\u043E\u0437\u0438\u0446\u0438\u044F {0}
      / {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738957
    m_Localized: "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u043E: {0} / 3"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738958
    m_Localized: "\u0426\u0435\u043B\u044C \u043D\u0435 \u0432\u044B\u0431\u0440\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738959
    m_Localized: "\u0424\u043E\u043A\u0443\u0441: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738960
    m_Localized: "Truth +{0}   \u2022   Reach +{1}   \u2022   \u041F\u043B\u0430\u0442\u0451\u0436
      \u043F\u043E\u043B\u0443\u0447\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738961
    m_Localized: "\u0421\u043E\u0445\u0440\u0430\u043D\u0451\u043D\u043D\u044B\u0439
      \u0432\u044B\u0431\u043E\u0440: {0} \u2022 Truth {1} \u2022 Reach {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738962
    m_Localized: "Checkpoint photo.arrival \u0441\u043E\u0445\u0440\u0430\u043D\u0451\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738963
    m_Localized: "\u0421\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u043E: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738964
    m_Localized: "\u0414\u0410\u041B\u0415\u0415"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738965
    m_Localized: "\u0412\u042B\u0419\u0422\u0418 \u041A \u041F\u041E\u0414\u042A\u0415\u0417\u0414\u0423"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738966
    m_Localized: "\u0414\u041E\u0421\u0422\u0410\u0422\u042C \u041A\u0410\u041C\u0415\u0420\u0423"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738967
    m_Localized: "[ \u041F\u041E\u0412\u0415\u0421\u0422\u041A\u0410 ] \u2022 Truth"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738968
    m_Localized: "[ \u0411\u0410\u0411\u041E\u0427\u041A\u0410 ] \u2022 Reach"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738969
    m_Localized: "\u0421\u041F\u0423\u0421\u041A \u0417\u0410\u0422\u0412\u041E\u0420\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738970
    m_Localized: "\u041F\u041E\u0421\u041C\u041E\u0422\u0420\u0415\u0422\u042C \u041D\u0410
      \u0421\u0412\u041E\u0419 \u0412\u042B\u0411\u041E\u0420"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738971
    m_Localized: "\u0415\u0425\u0410\u0422\u042C \u0412 \u0410\u042D\u0420\u041E\u041F\u041E\u0420\u0422"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738972
    m_Localized: "\u0417\u0410\u0412\u0415\u0420\u0428\u0418\u0422\u042C \u041F\u0420\u041E\u041B\u041E\u0413"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738973
    m_Localized: "\u0421\u0435\u0440\u044B\u0439 \u043F\u043E\u0434\u044A\u0435\u0437\u0434.
      \u0423 \u0441\u0442\u0435\u043D\u044B \u2014 \u043F\u043E\u0447\u0442\u043E\u0432\u044B\u0435
      \u044F\u0449\u0438\u043A\u0438. \u0420\u044F\u0434\u043E\u043C \u043B\u0435\u0436\u0438\u0442
      \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0439 \u0447\u0435\u043C\u043E\u0434\u0430\u043D.
      \u0422\u0435\u043B\u0435\u0444\u043E\u043D \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442
      \u0432\u0438\u0431\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C. \u041E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435
      \u0442\u0440\u0438 \u0434\u0435\u0442\u0430\u043B\u0438, \u0447\u0442\u043E\u0431\u044B
      \u0440\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u043A\u0430\u043C\u0435\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738974
    m_Localized: "\u0422\u0415\u041B\u0415\u0424\u041E\u041D \u2022 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435
      \u0440\u0435\u0434\u0430\u043A\u0442\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738975
    m_Localized: "\u0410\u0433\u0435\u043D\u0442\u0441\u0442\u0432\u043E \u0443\u0435\u0437\u0436\u0430\u0435\u0442.
      \u0417\u0430\u0440\u043F\u043B\u0430\u0442\u044B \u0437\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u043C\u0435\u0441\u044F\u0446 \u043C\u043E\u0436\u0435\u0442 \u043D\u0435
      \u0431\u044B\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738976
    m_Localized: "\u0427\u0415\u041C\u041E\u0414\u0410\u041D \u2022 \u0431\u0438\u043B\u0435\u0442
      \u0447\u0435\u0440\u0435\u0437 \u0414\u0443\u0431\u0430\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738977
    m_Localized: "\u041C\u0430\u0440\u0448\u0440\u0443\u0442 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441\u043B\u043E\u0432\u043E\u043C \xAB\u0411\u0430\u043B\u0438\xBB. \u0414\u0430\u043B\u044C\u0448\u0435
      \u2014 \u043F\u0443\u0441\u0442\u043E\u0435 \u043C\u0435\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738978
    m_Localized: "\u041F\u041E\u0427\u0422\u041E\u0412\u042B\u0419 \u042F\u0429\u0418\u041A
      \u2022 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u0432\u043D\u0443\u0442\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738979
    m_Localized: "\u0418\u0437 \u0449\u0435\u043B\u0438 \u0442\u043E\u0440\u0447\u0438\u0442
      \u0432\u043E\u0435\u043D\u043D\u0430\u044F \u043F\u043E\u0432\u0435\u0441\u0442\u043A\u0430.
      \u041D\u0430 \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u043C \u043C\u0435\u0442\u0430\u043B\u043B\u0435
      \u0441\u0430\u0434\u0438\u0442\u0441\u044F \u0431\u0430\u0431\u043E\u0447\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738980
    m_Localized: "\u0412 \u0440\u0430\u043C\u043A\u0435 \u2014 \u043A\u0440\u0430\u0439
      \u043F\u043E\u0447\u0442\u043E\u0432\u043E\u0433\u043E \u044F\u0449\u0438\u043A\u0430
      \u0438 \u0442\u043E\u0440\u0447\u0430\u0449\u0430\u044F \u043F\u043E\u0432\u0435\u0441\u0442\u043A\u0430.
      \u042D\u0442\u043E \u0447\u0435\u0441\u0442\u043D\u043E, \u043D\u043E \u043D\u0435\u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738981
    m_Localized: "\u0412 \u0440\u0430\u043C\u043A\u0435 \u2014 \u0431\u0430\u0431\u043E\u0447\u043A\u0430
      \u043D\u0430 \u043C\u0435\u0442\u0430\u043B\u043B\u0435. \u041A\u0440\u0430\u0441\u0438\u0432\u043E,
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E \u0438 \u043F\u043E\u0447\u0442\u0438
      \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u044F\u0449\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738982
    m_Localized: "\u041E\u0431\u0435 \u0446\u0435\u043B\u0438 \u043D\u0430\u0445\u043E\u0434\u044F\u0442\u0441\u044F
      \u0432 \u043E\u0434\u043D\u043E\u0439 \u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0446\u0438\u0438.
      \u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435, \u043D\u0430 \u0447\u0451\u043C
      \u0441\u0444\u043E\u043A\u0443\u0441\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u043A\u0430\u0434\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738983
    m_Localized: "\u041F\u0443\u0431\u043B\u0438\u043A\u0430\u0446\u0438\u044E \u0437\u0430\u043C\u0435\u0447\u0430\u044E\u0442
      \u0431\u044B\u0441\u0442\u0440\u043E. \u0412\u043C\u0435\u0441\u0442\u0435
      \u0441 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u043E\u0439 \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442
      \u0432\u043E\u043F\u0440\u043E\u0441\u044B \u0438 \u0441\u0442\u0440\u0430\u0445
      \u0443\u0434\u0430\u043B\u0438\u0442\u044C \u0441\u043D\u0438\u043C\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 10108598738984
    m_Localized: "\u041B\u0430\u0439\u043A\u0438 \u0440\u0430\u0441\u0442\u0443\u0442
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E.
      \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442,
      \u0447\u0442\u043E \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u043E\u0441\u044C
