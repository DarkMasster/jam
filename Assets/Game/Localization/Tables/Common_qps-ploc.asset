      m_Items: []
  - m_Id: 1819271170
    m_Localized: "\u042F\u0417\u042B\u041A: \u0420\u0423\u0421\u0421\u041A\u0418\u0419"
    m_Metadata:
      m_Items: []
  - m_Id: 1819271171
    m_Localized: "\u0421\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u043D\u0435
      \u043D\u0430\u0439\u0434\u0435\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1819271172
    m_Localized: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u0442\u043E\u0447\u043A\u0430:
      {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1819271173
    m_Localized: "\u0417\u0430\u0433\u0440\u0443\u0437\u043A\u0430\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1819271174
    m_Localized: "\u041D\u0435 \u043D\u0430\u0439\u0434\u0435\u043D\u0430 \u0441\u0446\u0435\u043D\u0430
      \u043D\u0430\u0447\u0430\u043B\u0430 \u0438\u0433\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1819271175
    m_Localized: "\u0421\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u043D\u0435
      \u043D\u0430\u0439\u0434\u0435\u043D\u043E \u0438\u043B\u0438 \u0443\u0441\u0442\u0430\u0440\u0435\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1819271176
    m_Localized: "\u0412\u042B\u0411\u0415\u0420\u0418\u0422\u0415 \u0418\u0421\u0422\u041E\u0420\u0418\u042E"
    m_Metadata:
      m_Items: []
  - m_Id: 1819271177
    m_Localized: "\u0422\u0420\u0418 \u041C\u0410\u0420\u0428\u0420\u0423\u0422\u0410
      \u2022 \u041E\u0414\u0418\u041D \u0414\u0415\u041D\u042C"
    m_Metadata:
      m_Items: []
  - m_Id: 1819271178
    m_Localized: "\u041F\u0420\u041E\u0419\u0414\u0415\u041D\u041E \u0418\u0421\u0422\u041E\u0420\u0418\u0419:
      {0} / 3"
    m_Metadata:
      m_Items: []
  - m_Id: 1819271179
    m_Localized: "\u041C\u041E\u0421\u041A\u0412\u0410 \u2192 \u0422\u0411\u0418\u041B\u0418\u0421\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 1819271180
    m_Localized: "\u0420\u0423\u041A\u041E\u0412\u041E\u0414\u0418\u0422\u0415\u041B\u042C
      \u2022 \u0414\u041E\u0420\u041E\u0413\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 1819271181
    m_Localized: "\u0415\u041A\u0410\u0422\u0415\u0420\u0418\u041D\u0411\u0423\u0420\u0413
      \u2192 \u0410\u041B\u041C\u0410\u0422\u042B"
    m_Metadata:
      m_Items: []
  - m_Id: 1819271182
    m_Localized: "\u0420\u0410\u0417\u0420\u0410\u0411\u041E\u0422\u0427\u0418\u041A
      \u2022 \u041E\u0424\u0418\u0421\u041D\u042B\u0419 \u041A\u041E\u0428\u041C\u0410\u0420"
    m_Metadata:
      m_Items: []
  - m_Id: 1819271183
    m_Localized: "\u0421\u0410\u041D\u041A\u0422-\u041F\u0415\u0422\u0415\u0420\u0411\u0423\u0420\u0413
      \u2192 \u0411\u0410\u041B\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 1819271184
    m_Localized: "\u0424\u041E\u0422\u041E\u0413\u0420\u0410\u0424\u041A\u0410 \u2022
      \u0427\u0415\u0421\u0422\u041D\u042B\u0419 \u041A\u0410\u0414\u0420"
    m_Metadata:
      m_Items: []
  - m_Id: 1819271185
    m_Localized: "\u2713 \u041F\u0420\u041E\u0419\u0414\u0415\u041D\u041E"
    m_Metadata:
      m_Items: []
  - m_Id: 1819271186
    m_Localized: "\u2022 \u0422\u0415\u041A\u0423\u0429\u0410\u042F"
    m_Metadata:
      m_Items: []
  - m_Id: 1819271187
    m_Localized: "\u0424\u0418\u041D\u0410\u041B \u2022 \u0417\u0410\u0411\u041B\u041E\u041A\u0418\u0420\u041E\u0412\u0410\u041D"
    m_Metadata:
      m_Items: []
  - m_Id: 1819271188
    m_Localized: "\u0424\u0418\u041D\u0410\u041B \u2022 \u0420\u0410\u0417\u0411\u041B\u041E\u041A\u0418\u0420\u041E\u0412\u0410\u041D"
    m_Metadata:
      m_Items: []
  - m_Id: 1819271189
    m_Localized: "\u041D\u0410\u0417\u0410\u0414 \u0412 \u0413\u041B\u0410\u0412\u041D\u041E\u0415
      \u041C\u0415\u041D\u042E"
    m_Metadata:
      m_Items: []
  - m_Id: 1819271190
    m_Localized: "\u0418\u0441\u0442\u043E\u0440\u0438\u0438 \u043C\u043E\u0436\u043D\u043E
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442\u044C \u0432 \u043B\u044E\u0431\u043E\u043C
      \u043F\u043E\u0440\u044F\u0434\u043A\u0435. \u041F\u0440\u043E\u0433\u0440\u0435\u0441\u0441
      \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442\u0441\u044F \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1819271191
    m_Localized: "\u0412\u0441\u0435 \u0442\u0440\u0438 \u043B\u0438\u043D\u0438\u0438
      \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u044B. \u0424\u0438\u043D\u0430\u043B
      \u0440\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 1819271192
    m_Localized: "\u0421\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435\u2026
      \u0417\u0430\u0433\u0440\u0443\u0437\u043A\u0430\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1819271193
    m_Localized: "\u041C\u0415\u041D\u042E  [ESC]"
    m_Metadata:
      m_Items: []
  - m_Id: 1819271194
    m_Localized: "\u041C\u0415\u041D\u042E"
    m_Metadata:
      m_Items: []
  - m_Id: 1819271195
    m_Localized: "\u0418\u0413\u0420\u0410 \u041F\u0420\u0418\u041E\u0421\u0422\u0410\u041D\u041E\u0412\u041B\u0415\u041D\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 1819271196
    m_Localized: "\u041F\u0420\u041E\u0414\u041E\u041B\u0416\u0418\u0422\u042C"
    m_Metadata:
      m_Items: []
  - m_Id: 1819271197
    m_Localized: "\u0421\u041E\u0425\u0420\u0410\u041D\u0418\u0422\u042C"
    m_Metadata:
      m_Items: []
  - m_Id: 1819271198
    m_Localized: "\u0412\u042B\u0419\u0422\u0418 \u0412 \u0413\u041B\u0410\u0412\u041D\u041E\u0415
      \u041C\u0415\u041D\u042E"
    m_Metadata:
      m_Items: []
  - m_Id: 1819271199
    m_Localized: "\u0421\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u0437\u0430\u043F\u0438\u0448\u0435\u0442
      \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u0442\u0435\u043A\u0443\u0449\u0435\u0433\u043E
      \u0440\u0435\u0436\u0438\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1819271200
    m_Localized: "\u042D\u0442\u043E\u0442 \u0440\u0435\u0436\u0438\u043C \u043F\u043E\u043A\u0430
      \u043D\u0435 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442
      \u0440\u0443\u0447\u043D\u043E\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1819271201
    m_Localized: "{0} / {1}   \u2022   \u041F\u0420\u041E\u0411\u0415\u041B / \u041A\u041B\u0418\u041A"
    m_Metadata:
      m_Items: []
  - m_Id: 1819271202
    m_Localized: "\u041F\u0420\u041E\u041F\u0423\u0421\u0422\u0418\u0422\u042C  [ESC]"
    m_Metadata:
      m_Items: []
  - m_Id: 9091001868288
    m_Localized: "\u0424\u0438\u043D\u0430\u043B \u0440\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D,
      \u043D\u043E \u0441\u0446\u0435\u043D\u0430 Finale \u0435\u0449\u0451 \u043D\u0435
      \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0430 \u0432 Build Settings."
    m_Metadata:
      m_Items: []
  - m_Id: 9091073171456
    m_Localized: "\u0414\u043B\u044F \u043B\u0438\u043D\u0438\u0438 {0} \u043D\u0435
      \u043D\u0430\u0439\u0434\u0435\u043D\u0430 \u0438\u0433\u0440\u043E\u0432\u0430\u044F
      \u0441\u0446\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 58021009940480
    m_Localized: "\u0422\u0420\u0410\u041D\u0417\u0418\u0422\u041D\u0410\u042F \u0413\u041E\u0421\u0422\u0418\u041D\u0418\u0426\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 58021035106304
    m_Localized: "\u041F\u0440\u043E\u0433\u0440\u0435\u0441\u0441 \u0441\u043E\u0445\u0440\u0430\u043D\u0451\u043D.
      \u041E\u0441\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044F \u0438\u0441\u0442\u043E\u0440\u0438\u0438
      \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B \u0432 \u043B\u044E\u0431\u043E\u043C
      \u043F\u043E\u0440\u044F\u0434\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 58021035106305
    m_Localized: "\u0412\u0415\u0420\u041D\u0423\u0422\u042C\u0421\u042F \u041A \u0412\u042B\u0411\u041E\u0420\u0423
      \u0418\u0421\u0422\u041E\u0420\u0418\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 58021035106306
    m_Localized: "\u041C\u0410\u0420\u0428\u0420\u0423\u0422 \u041F\u0420\u041E\u0414\u041E\u041B\u0416\u0410\u0415\u0422\u0421\u042F"
    m_Metadata:
      m_Items: []
  - m_Id: 58021035106307
    m_Localized: "\u0414\u0432\u0435\u0440\u044C \u043D\u043E\u043C\u0435\u0440\u0430
      \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F. \u041F\u0435\u0440\u0432\u0430\u044F
      \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
      \u0442\u0438\u0448\u0438\u043D\u0430 \u0437\u0430 \u0432\u0435\u0441\u044C
      \u0434\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 58021035106308
    m_Localized: "\u0414\u0432\u0435\u0440\u044C \u043D\u043E\u043C\u0435\u0440\u0430
      \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F. \u0421\u0435\u043C\u044C\u044F
      \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u0441\u043F\u0438\u0442, \u0430
      \u043E\u0447\u0435\u0440\u0435\u0434\u044C \u043D\u0430 \u0433\u0440\u0430\u043D\u0438\u0446\u0435
      \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u043F\u043E\u0437\u0430\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 58021035106309
    m_Localized: "\u0414\u0432\u0435\u0440\u044C \u043D\u043E\u043C\u0435\u0440\u0430
      \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F. \u041D\u043E\u0443\u0442\u0431\u0443\u043A
      \u0438 \u043A\u0440\u0443\u0436\u043A\u0430 \u043B\u0435\u0436\u0430\u0442
      \u043D\u0430 \u0441\u0442\u043E\u043B\u0435, \u043E\u0444\u0438\u0441 \u043E\u0441\u0442\u0430\u043B\u0441\u044F
      \u0432\u043E \u0441\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 58021035106310
    m_Localized: "\u0414\u0432\u0435\u0440\u044C \u043D\u043E\u043C\u0435\u0440\u0430
      \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F. \u041D\u0430
      \u044D\u043A\u0440\u0430\u043D\u0435 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0430
      \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u043A\u0430\u0434\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 350454767673344
    m_Localized: "\u042D\u041F\u0418\u041B\u041E\u0413 \u2022 \u0417\u0410\u0411\u041B\u041E\u041A\u0418\u0420\u041E\u0412\u0410\u041D"
    m_Metadata:
      m_Items: []
  - m_Id: 350454847365120
    m_Localized: "\u042D\u041F\u0418\u041B\u041E\u0413 \u2022 \u0420\u0410\u0417\u0411\u041B\u041E\u041A\u0418\u0420\u041E\u0412\u0410\u041D"
    m_Metadata:
      m_Items: []
  - m_Id: 350454847365121
    m_Localized: "\u041B\u0438\u043D\u0438\u0438 \u0432\u0442\u043E\u0440\u043E\u0433\u043E
      \u0438 \u0442\u0440\u0435\u0442\u044C\u0435\u0433\u043E \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0435\u0439
      \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u044B. \u042D\u043F\u0438\u043B\u043E\u0433
      \u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 350454847365122
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043E\u0442\u043A\u0440\u044B\u0442\u044C
      \u044D\u043F\u0438\u043B\u043E\u0433 \u0432 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0435."
    m_Metadata:
      m_Items: []
