  m_TableData:
  - m_Id: 766500864
    m_Localized: "HANDS FREE \u2022 APPROACH A HIGHLIGHTED ITEM"
    m_Metadata:
      m_Items: []
  - m_Id: 816832512
    m_Localized: STARTING OFFICE
    m_Metadata:
      m_Items: []
  - m_Id: 816832513
    m_Localized: COLLECT PERSONAL ITEMS   {0}   {1}
    m_Metadata:
      m_Items: []
  - m_Id: 816832514
    m_Localized: '[ ] LAPTOP'
    m_Metadata:
      m_Items: []
  - m_Id: 816832515
    m_Localized: '[X] LAPTOP'
    m_Metadata:
      m_Items: []
  - m_Id: 816832516
    m_Localized: '[ ] MUG'
    m_Metadata:
      m_Items: []
  - m_Id: 816832517
    m_Localized: '[X] MUG'
    m_Metadata:
      m_Items: []
  - m_Id: 816832518
    m_Localized: IDLE
    m_Metadata:
      m_Items: []
  - m_Id: 816832519
    m_Localized: MOVING
    m_Metadata:
      m_Items: []
  - m_Id: 816832520
    m_Localized: MOMENTUM {0}%   {1}
    m_Metadata:
      m_Items: []
  - m_Id: 816832521
    m_Localized: KEYBOARD
    m_Metadata:
      m_Items: []
  - m_Id: 816832522
    m_Localized: PRINTER
    m_Metadata:
      m_Items: []
  - m_Id: 816832523
    m_Localized: OFFICE CHAIR
    m_Metadata:
      m_Items: []
  - m_Id: 9088472702976
    m_Localized: "WASD / ARROWS \u2022 MOVE TOWARD EXIT"
    m_Metadata:
      m_Items: []
  - m_Id: 9088518840320
    m_Localized: "CARRYING: {0} \u2022 PRIMARY \u2014 THROW"
    m_Metadata:
      m_Items: []
  - m_Id: 9088518840321
    m_Localized: CAPACITY {0}   ATTEMPT {1}
    m_Metadata:
      m_Items: []
  - m_Id: 9088518840322
    m_Localized: 'PERFORMANCE UNSATISFACTORY

      ATTEMPT {0} IS STARTING'
    m_Metadata:
      m_Items: []
  - m_Id: 9088518840323
    m_Localized: "LAPTOP COLLECTED \u2022 MUG REMAINS"
    m_Metadata:
      m_Items: []
  - m_Id: 9088518840324
    m_Localized: "MUG COLLECTED \u2022 LAPTOP REMAINS"
    m_Metadata:
      m_Items: []
  - m_Id: 9088518840325
    m_Localized: "PERSONAL ITEMS COLLECTED \u2022 REACH EXIT"
    m_Metadata:
      m_Items: []
  - m_Id: 9088518840326
    m_Localized: "DESTROYED: {0} \u2022 {1}/{2} \u2022 MOMENTUM RISING"
    m_Metadata:
      m_Items: []
  - m_Id: 9088518840327
    m_Localized: "WRITTEN OFF: {0} \u2022 {1}/{2} \u2022 MOMENTUM RISING"
    m_Metadata:
      m_Items: []
  - m_Id: 9088518840328
    m_Localized: "{0} MISSED \u2022 THROW WINDOW OPEN"
    m_Metadata:
      m_Items: []
  - m_Id: 9088518840329
    m_Localized: "PICKED UP: {0} \u2022 HANDS OCCUPIED"
    m_Metadata:
      m_Items: []
  - m_Id: 9088518840330
    m_Localized: 'THROWN: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 9088518840331
    m_Localized: "HIT: {0} \u2022 CAPACITY {1}/{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 9088518840332
    m_Localized: "BURNOUT \u2022 CAUSE: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 9088518840333
    m_Localized: "WORKDAY RESTARTED \u2022 ATTEMPT {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 9088518840334
    m_Localized: LAPTOP AND MUG REQUIRED
    m_Metadata:
      m_Items: []
  - m_Id: 9088518840335
    m_Localized: LAPTOP REQUIRED
    m_Metadata:
      m_Items: []
  - m_Id: 9088518840336
    m_Localized: MUG REQUIRED
    m_Metadata:
      m_Items: []
  - m_Id: 9088518840337
    m_Localized: "ACCESS DENIED \u2022 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 9088518840338
    m_Localized: "EXIT IS A FALSE GOAL \u2022 SERVER BOSS AHEAD"
    m_Metadata:
      m_Items: []
  - m_Id: 9088518840339
    m_Localized: "ACCESS REVOKED \u2022 BOSS ZONE READY FOR THE NEXT SLICE"
    m_Metadata:
      m_Items: []
  - m_Id: 13655453196288
    m_Localized: "WASD / ARROWS \u2014 MOVE FORWARD"
    m_Metadata:
      m_Items: []
  - m_Id: 13655524499456
    m_Localized: "ITEMS ARE PICKED UP AUTOMATICALLY \u2014 APPROACH THE HIGHLIGHT"
    m_Metadata:
      m_Items: []
  - m_Id: 13655524499457
    m_Localized: "PRIMARY \u2014 THROW THE ITEM AT OFFICE EQUIPMENT"
    m_Metadata:
      m_Items: []
  - m_Id: 13655524499458
    m_Localized: "RED STRIP \u2014 STEP OUT OF THE CHARGE LINE"
    m_Metadata:
      m_Items: []
  - m_Id: 13655524499459
    m_Localized: COLLECT THE LAPTOP AND MUG, THEN GO TO EXIT
    m_Metadata:
      m_Items: []
  - m_Id: 13655524499460
    m_Localized: "YOU HAVE YOUR THINGS \u2014 EXIT IS STRAIGHT AHEAD"
    m_Metadata:
      m_Items: []
  - m_Id: 13655524499461
    m_Localized: "THE REFLECTION WALKS BESIDE YOU \u2022 IT IS STILL YOU"
    m_Metadata:
      m_Items: []
  - m_Id: 13655524499462
    m_Localized: 'FORGOTTEN ITEMS WAIT AT EXIT: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 13655524499463
    m_Localized: LAPTOP
    m_Metadata:
      m_Items: []
  - m_Id: 13655524499464
    m_Localized: MUG
    m_Metadata:
      m_Items: []
  - m_Id: 13655524499465
    m_Localized: '{0} AND {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 19775198584832
    m_Localized: SERVER BOSS
    m_Metadata:
      m_Items: []
  - m_Id: 19775282470912
    m_Localized: SERVER RING
    m_Metadata:
      m_Items: []
  - m_Id: 19775282470913
    m_Localized: EMPLOYEE NO LONGER REQUIRED
    m_Metadata:
      m_Items: []
  - m_Id: 19775286665216
    m_Localized: AI DOES THIS FASTER
    m_Metadata:
      m_Items: []
  - m_Id: 19775286665217
    m_Localized: YOU TRAINED YOUR REPLACEMENT
    m_Metadata:
      m_Items: []
  - m_Id: 19775286665218
    m_Localized: YOUR ROLE HAS BEEN OPTIMIZED
    m_Metadata:
      m_Items: []
  - m_Id: 19775286665219
    m_Localized: SCALING COMPLETE
    m_Metadata:
      m_Items: []
  - m_Id: 19775286665220
    m_Localized: HUMAN ERROR DETECTED
    m_Metadata:
      m_Items: []
  - m_Id: 19775286665221
    m_Localized: YOU WERE THE BOTTLENECK
    m_Metadata:
      m_Items: []
  - m_Id: 19775286665222
    m_Localized: ACCESS REVOKED
    m_Metadata:
      m_Items: []
  - m_Id: 19775286665223
    m_Localized: OFFBOARDING COMPLETE
    m_Metadata:
      m_Items: []
  - m_Id: 19775286665224
    m_Localized: "RACKS CONVERGING \u2022 CONTROL LOCKED"
    m_Metadata:
      m_Items: []
  - m_Id: 19775286665225
    m_Localized: "ASSEMBLED BODY ONLINE \u2022 THROW OBJECTS"
    m_Metadata:
      m_Items: []
  - m_Id: 19775286665226
    m_Localized: "CHASSIS FAILURE \u2022 {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 19775286665227
    m_Localized: "FALSE VICTORY \u2022 RACKS RECONFIGURING"
    m_Metadata:
      m_Items: []
  - m_Id: 19775286665228
    m_Localized: "RING CLOSED \u2022 MOVE WHILE YOU STILL CAN"
    m_Metadata:
      m_Items: []
  - m_Id: 19775286665229
    m_Localized: "RACKS SYNCHRONIZING \u2022 NO SAFE ZONE"
    m_Metadata:
      m_Items: []
  - m_Id: 19775286665230
    m_Localized: "SCRIPTED DEFEAT \u2022 EPISODE COMPLETE"
    m_Metadata:
      m_Items: []
  - m_Id: 19775286665231
    m_Localized: 'OFFBOARDING COMPLETE

      THE DREAM CUTS OUT'
    m_Metadata:
      m_Items: []
  - m_Id: 19775286665232
    m_Localized: "ASSEMBLING CHASSIS \u2022 HOLD POSITION"
    m_Metadata:
      m_Items: []
  - m_Id: 19775286665233
    m_Localized: BREAK THE ASSEMBLED BODY   {0}/{1}
    m_Metadata:
      m_Items: []
  - m_Id: 19775286665234
    m_Localized: "FALSE VICTORY \u2022 RACKS ARE SURROUNDING YOU"
    m_Metadata:
      m_Items: []
  - m_Id: 19775286665235
    m_Localized: "SERVER RING \u2022 NO EXIT"
    m_Metadata:
      m_Items: []
  - m_Id: 19775286665236
    m_Localized: "FINAL STRIKE \u2022 SHARED TELEGRAPH"
    m_Metadata:
      m_Items: []
  - m_Id: 19775286665237
    m_Localized: "OFFBOARDING COMPLETE \u2022 DREAM ENDED"
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443520
    m_Localized: Office nightmare
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443521
    m_Localized: FRIEND AT THE WHEEL
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443522
    m_Localized: The queue has not moved for four hours. Sleep, I will wake you at
      the border.
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443523
    m_Localized: HIM
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443524
    m_Localized: "His backpack holds a laptop and a mug from the office\u2014everything
      he managed to take from his last job. His eyes close on their own."
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443525
    m_Localized: THE DREAM
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443526
    m_Localized: Fluorescent lamps, rows of desks fading into darkness, and a red
      EXIT sign at the end of the floor.
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443527
    m_Localized: THE SERVER RING
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443528
    m_Localized: The racks close in. The light fades away, and the office finally
      lets go.
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443529
    m_Localized: HIM
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443530
    m_Localized: He wakes in someone else's car to a knock on the roof. His palms
      are damp, and his mouth tastes of toner.
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443531
    m_Localized: FRIEND AT THE WHEEL
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443532
    m_Localized: "The queue is moving. Get your passport ready\u2014the border is
      twenty minutes away."
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443533
    m_Localized: "BORDER QUEUE \u2022 THE HERO FALLS ASLEEP IN THE CAR"
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443534
    m_Localized: "THE DREAM BEGINS \u2022 THE OFFICE HE HAS JUST LOST"
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443535
    m_Localized: COLLECT PERSONAL ITEMS AND REACH EXIT
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443536
    m_Localized: "WAKING UP IN THE CAR \u2022 THE QUEUE IS MOVING"
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443537
    m_Localized: He wakes up in the border queue. The office stayed behind in the
      dream; the laptop and the mug are on his lap. The hotel-room door in Almaty
      will not close until evening.
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443538
    m_Localized: RUN RESTARTS
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443539
    m_Localized: LAPTOP
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443540
    m_Localized: MUG
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443541
    m_Localized: EQUIPMENT DESTROYED
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443542
    m_Localized: CHAIRS WRITTEN OFF
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443543
    m_Localized: YES
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443544
    m_Localized: NO
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443545
    m_Localized: THE DREAM BEGINS
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443546
    m_Localized: "WAKING UP \u2022 THE QUEUE IS MOVING"
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443547
    m_Localized: "PROGRESS SAVED \u2022 ATTEMPT {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443548
    m_Localized: Office run saved.
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443549
    m_Localized: Saving is unavailable right now.
    m_Metadata:
      m_Items: []
  references:
