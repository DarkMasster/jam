    m_Localized: "\u0421\u0411\u041E\u0420\u041A\u0410 \u041A\u041E\u0420\u041F\u0423\u0421\u0410
      \u2022 \u041D\u0415 \u0414\u0412\u0418\u0413\u0410\u0422\u042C\u0421\u042F"
    m_Metadata:
      m_Items: []
  - m_Id: 19775286665233
    m_Localized: "\u0420\u0410\u0417\u0420\u0423\u0428\u042C \u0415\u0414\u0418\u041D\u042B\u0419
      \u041A\u041E\u0420\u041F\u0423\u0421   {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 19775286665234
    m_Localized: "\u041B\u041E\u0416\u041D\u0410\u042F \u041F\u041E\u0411\u0415\u0414\u0410
      \u2022 \u0421\u0422\u041E\u0419\u041A\u0418 \u041E\u041A\u0420\u0423\u0416\u0410\u042E\u0422
      \u0422\u0415\u0411\u042F"
    m_Metadata:
      m_Items: []
  - m_Id: 19775286665235
    m_Localized: "\u0421\u0415\u0420\u0412\u0415\u0420\u041D\u041E\u0415 \u041A\u041E\u041B\u042C\u0426\u041E
      \u2022 \u0412\u042B\u0425\u041E\u0414\u0410 \u041D\u0415\u0422"
    m_Metadata:
      m_Items: []
  - m_Id: 19775286665236
    m_Localized: "\u0424\u0418\u041D\u0410\u041B\u042C\u041D\u042B\u0419 \u0423\u0414\u0410\u0420
      \u2022 \u041E\u0411\u0429\u0418\u0419 \u0422\u0415\u041B\u0415\u0413\u0420\u0410\u0424"
    m_Metadata:
      m_Items: []
  - m_Id: 19775286665237
    m_Localized: "OFFBOARDING \u0417\u0410\u0412\u0415\u0420\u0428\u0401\u041D \u2022
      \u0421\u041E\u041D \u041E\u0411\u041E\u0420\u0412\u0410\u041D"
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443520
    m_Localized: "\u041E\u0444\u0438\u0441\u043D\u044B\u0439 \u043A\u043E\u0448\u043C\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443521
    m_Localized: "\u0414\u0420\u0423\u0413 \u0417\u0410 \u0420\u0423\u041B\u0401\u041C"
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443522
    m_Localized: "\u041E\u0447\u0435\u0440\u0435\u0434\u044C \u0441\u0442\u043E\u0438\u0442
      \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u044B\u0439 \u0447\u0430\u0441.
      \u0421\u043F\u0438, \u0440\u0430\u0437\u0431\u0443\u0436\u0443 \u043D\u0430
      \u0433\u0440\u0430\u043D\u0438\u0446\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443523
    m_Localized: "\u041E\u041D"
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443524
    m_Localized: "\u0412 \u0440\u044E\u043A\u0437\u0430\u043A\u0435 \u043D\u043E\u0443\u0442\u0431\u0443\u043A
      \u0438 \u043A\u0440\u0443\u0436\u043A\u0430 \u0438\u0437 \u043E\u0444\u0438\u0441\u0430
      \u2014 \u0432\u0441\u0451, \u0447\u0442\u043E \u043E\u043D \u0443\u0441\u043F\u0435\u043B
      \u0437\u0430\u0431\u0440\u0430\u0442\u044C \u0441 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439
      \u0440\u0430\u0431\u043E\u0442\u044B. \u0413\u043B\u0430\u0437\u0430 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u0441\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443525
    m_Localized: "\u0421\u041E\u041D"
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443526
    m_Localized: "\u041B\u0430\u043C\u043F\u044B \u0434\u043D\u0435\u0432\u043D\u043E\u0433\u043E
      \u0441\u0432\u0435\u0442\u0430, \u0440\u044F\u0434\u044B \u0441\u0442\u043E\u043B\u043E\u0432
      \u0434\u043E \u0442\u0435\u043C\u043D\u043E\u0442\u044B \u0438 \u043A\u0440\u0430\u0441\u043D\u0430\u044F
      \u0442\u0430\u0431\u043B\u0438\u0447\u043A\u0430 EXIT \u0432 \u043A\u043E\u043D\u0446\u0435
      \u044D\u0442\u0430\u0436\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443527
    m_Localized: "\u0421\u0415\u0420\u0412\u0415\u0420\u041D\u041E\u0415 \u041A\u041E\u041B\u042C\u0426\u041E"
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443528
    m_Localized: "\u0421\u0442\u043E\u0439\u043A\u0438 \u0441\u043C\u044B\u043A\u0430\u044E\u0442\u0441\u044F.
      \u0421\u0432\u0435\u0442 \u0443\u0445\u043E\u0434\u0438\u0442, \u0438 \u043E\u0444\u0438\u0441
      \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443529
    m_Localized: "\u041E\u041D"
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443530
    m_Localized: "\u041E\u043D \u043F\u0440\u043E\u0441\u044B\u043F\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0447\u0443\u0436\u043E\u0439 \u043C\u0430\u0448\u0438\u043D\u0435
      \u043E\u0442 \u0441\u0442\u0443\u043A\u0430 \u043F\u043E \u043A\u0440\u044B\u0448\u0435.
      \u041B\u0430\u0434\u043E\u043D\u0438 \u043C\u043E\u043A\u0440\u044B\u0435,
      \u0432\u043E \u0440\u0442\u0443 \u043F\u0440\u0438\u0432\u043A\u0443\u0441
      \u0442\u043E\u043D\u0435\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443531
    m_Localized: "\u0414\u0420\u0423\u0413 \u0417\u0410 \u0420\u0423\u041B\u0401\u041C"
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443532
    m_Localized: "\u041E\u0447\u0435\u0440\u0435\u0434\u044C \u043F\u043E\u0448\u043B\u0430.
      \u0413\u043E\u0442\u043E\u0432\u044C \u043F\u0430\u0441\u043F\u043E\u0440\u0442
      \u2014 \u0433\u0440\u0430\u043D\u0438\u0446\u0430 \u0447\u0435\u0440\u0435\u0437
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043C\u0438\u043D\u0443\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443533
    m_Localized: "\u041E\u0427\u0415\u0420\u0415\u0414\u042C \u041D\u0410 \u0413\u0420\u0410\u041D\u0418\u0426\u0415
      \u2022 \u0413\u0415\u0420\u041E\u0419 \u0417\u0410\u0421\u042B\u041F\u0410\u0415\u0422
      \u0412 \u041C\u0410\u0428\u0418\u041D\u0415"
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443534
    m_Localized: "\u0421\u041E\u041D \u041D\u0410\u0427\u0418\u041D\u0410\u0415\u0422\u0421\u042F
      \u2022 \u041E\u0424\u0418\u0421, \u041A\u041E\u0422\u041E\u0420\u042B\u0419
      \u041E\u041D \u0422\u041E\u041B\u042C\u041A\u041E \u0427\u0422\u041E \u041F\u041E\u0422\u0415\u0420\u042F\u041B"
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443535
    m_Localized: "\u0421\u041E\u0411\u0415\u0420\u0418 \u041B\u0418\u0427\u041D\u042B\u0415
      \u0412\u0415\u0429\u0418 \u0418 \u0414\u041E\u0411\u0415\u0420\u0418\u0421\u042C
      \u0414\u041E EXIT"
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443536
    m_Localized: "\u041F\u0420\u041E\u0411\u0423\u0416\u0414\u0415\u041D\u0418\u0415
      \u0412 \u041C\u0410\u0428\u0418\u041D\u0415 \u2022 \u041E\u0427\u0415\u0420\u0415\u0414\u042C
      \u041F\u041E\u0428\u041B\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443537
    m_Localized: "\u041E\u043D \u043F\u0440\u043E\u0441\u044B\u043F\u0430\u0435\u0442\u0441\u044F
      \u0432 \u043E\u0447\u0435\u0440\u0435\u0434\u0438 \u043D\u0430 \u0433\u0440\u0430\u043D\u0438\u0446\u0435.
      \u041E\u0444\u0438\u0441 \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0432\u043E
      \u0441\u043D\u0435, \u043D\u043E\u0443\u0442\u0431\u0443\u043A \u0438 \u043A\u0440\u0443\u0436\u043A\u0430
      \u2014 \u043D\u0430 \u043A\u043E\u043B\u0435\u043D\u044F\u0445. \u0414\u0432\u0435\u0440\u044C
      \u0433\u043E\u0441\u0442\u0438\u043D\u0438\u0447\u043D\u043E\u0433\u043E \u043D\u043E\u043C\u0435\u0440\u0430
      \u0432 \u0410\u043B\u043C\u0430\u0442\u044B \u0437\u0430\u043A\u0440\u043E\u0435\u0442\u0441\u044F
      \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u0435\u0447\u0435\u0440\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443538
    m_Localized: "\u041F\u0415\u0420\u0415\u0417\u0410\u041F\u0423\u0421\u041A\u041E\u0412
      \u0417\u0410\u0411\u0415\u0413\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443539
    m_Localized: "\u041D\u041E\u0423\u0422\u0411\u0423\u041A"
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443540
    m_Localized: "\u041A\u0420\u0423\u0416\u041A\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443541
    m_Localized: "\u0420\u0410\u0417\u0420\u0423\u0428\u0415\u041D\u041E \u0422\u0415\u0425\u041D\u0418\u041A\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443542
    m_Localized: "\u0421\u041F\u0418\u0421\u0410\u041D\u041E \u041A\u0420\u0415\u0421\u0415\u041B"
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443543
    m_Localized: "\u0415\u0421\u0422\u042C"
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443544
    m_Localized: "\u041D\u0415\u0422"
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443545
    m_Localized: "\u0421\u041E\u041D \u041D\u0410\u0427\u0418\u041D\u0410\u0415\u0422\u0421\u042F"
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443546
    m_Localized: "\u041F\u0420\u041E\u0411\u0423\u0416\u0414\u0415\u041D\u0418\u0415
      \u2022 \u041E\u0427\u0415\u0420\u0415\u0414\u042C \u041F\u041E\u0428\u041B\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443547
    m_Localized: "\u041F\u0420\u041E\u0413\u0420\u0415\u0421\u0421 \u0421\u041E\u0425\u0420\u0410\u041D\u0401\u041D
      \u2022 \u041F\u041E\u041F\u042B\u0422\u041A\u0410 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443548
    m_Localized: "\u041E\u0444\u0438\u0441\u043D\u044B\u0439 \u0437\u0430\u0431\u0435\u0433
      \u0441\u043E\u0445\u0440\u0430\u043D\u0451\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 58018430443549
    m_Localized: "\u0421\u0435\u0439\u0447\u0430\u0441 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435
      \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E."
    m_Metadata:
      m_Items: []
