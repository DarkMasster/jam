  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fcc89e7e717925b4ba27b59eaee5e6cc, type: 3}
  m_Name: PhotoIntroStoryboard
  m_EditorClassIdentifier: Assembly-CSharp::Jam.Core.Cutscenes.StoryboardCutsceneAsset
  skippable: 1
  frames:
  - background: {fileID: 0}
    portrait: {fileID: 0}
    speaker: "\u041E\u041D\u0410"
    text: "24 \u0444\u0435\u0432\u0440\u0430\u043B\u044F 2022 \u0433\u043E\u0434\u0430.
      \u0423\u0442\u0440\u043E \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
      \u0441 \u043D\u043E\u0432\u043E\u0441\u0442\u0435\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u043C
      \u043D\u0435 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043C\u0435\u0441\u0442\u0430
      \u0432 \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u043E\u0439 \u0436\u0438\u0437\u043D\u0438."
    voice: {fileID: 0}
    autoAdvanceSeconds: 0
  - background: {fileID: 0}
    portrait: {fileID: 0}
    speaker: "\u0420\u0415\u0414\u0410\u041A\u0422\u041E\u0420"
    text: "\u0410\u0433\u0435\u043D\u0442\u0441\u0442\u0432\u043E \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0440\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 \u043E\u0444\u0438\u0441.
      \u041F\u0440\u043E\u0435\u043A\u0442\u044B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u044B.
      \u041A\u043E\u043C\u0430\u043D\u0434\u0430 \u0440\u0430\u0441\u043F\u0443\u0449\u0435\u043D\u0430."
    voice: {fileID: 0}
    autoAdvanceSeconds: 0
  - background: {fileID: 0}
    portrait: {fileID: 0}
    speaker: "\u0422\u0415\u041B\u0415\u0424\u041E\u041D"
    text: "Forbidgram \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D.
      \u041A\u043B\u0438\u0435\u043D\u0442\u044B \u043C\u043E\u043B\u0447\u0430\u0442.
      \u0412 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0435 \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F
      \u0430\u0440\u0445\u0438\u0432, \u043D\u0435\u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0435
      \u0441\u0447\u0435\u0442\u0430 \u0438 \u0431\u0438\u043B\u0435\u0442 \u0432
      \u043E\u0434\u0438\u043D \u043A\u043E\u043D\u0435\u0446."
    voice: {fileID: 0}
    autoAdvanceSeconds: 0
  - background: {fileID: 0}
    portrait: {fileID: 0}
    speaker: "\u041E\u041D\u0410"
    text: "\u041F\u0435\u0440\u0435\u0434 \u043E\u0442\u044A\u0435\u0437\u0434\u043E\u043C
      \u043D\u0443\u0436\u0435\u043D \u0435\u0449\u0451 \u043E\u0434\u0438\u043D
      \u043A\u0430\u0434\u0440 \u2014 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u0447\u0435\u0441\u0442\u043D\u044B\u0439, \u0447\u0442\u043E\u0431\u044B
      \u043D\u0435 \u043F\u0440\u0435\u0434\u0430\u0442\u044C \u0441\u0435\u0431\u044F,
      \u0438 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0437\u0430\u043C\u0435\u0442\u043D\u044B\u0439,
      \u0447\u0442\u043E\u0431\u044B \u043E\u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \u0434\u043E\u0440\u043E\u0433\u0443."
    voice: {fileID: 0}
    autoAdvanceSeconds: 0
