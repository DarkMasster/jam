  m_Script: {fileID: 11500000, guid: fcc89e7e717925b4ba27b59eaee5e6cc, type: 3}
  m_Name: OfficeAwakeningStoryboard
  m_EditorClassIdentifier: Assembly-CSharp::Jam.Core.Cutscenes.StoryboardCutsceneAsset
  skippable: 1
  frames:
  - background: {fileID: 0}
    portrait: {fileID: 0}
    localizationTable: Office
    speakerKey: awakening.01.speaker
    textKey: awakening.01.text
    speaker: "\u0421\u0415\u0420\u0412\u0415\u0420\u041D\u041E\u0415 \u041A\u041E\u041B\u042C\u0426\u041E"
    text: "\u0421\u0442\u043E\u0439\u043A\u0438 \u0441\u043C\u044B\u043A\u0430\u044E\u0442\u0441\u044F.
      \u0421\u0432\u0435\u0442 \u0443\u0445\u043E\u0434\u0438\u0442, \u0438 \u043E\u0444\u0438\u0441
      \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u0435\u0442."
    voice: {fileID: 0}
    autoAdvanceSeconds: 0
  - background: {fileID: 0}
    portrait: {fileID: 0}
    localizationTable: Office
    speakerKey: awakening.02.speaker
    textKey: awakening.02.text
    speaker: "\u041E\u041D"
    text: "\u041E\u043D \u043F\u0440\u043E\u0441\u044B\u043F\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0447\u0443\u0436\u043E\u0439 \u043C\u0430\u0448\u0438\u043D\u0435
      \u043E\u0442 \u0441\u0442\u0443\u043A\u0430 \u043F\u043E \u043A\u0440\u044B\u0448\u0435.
      \u041B\u0430\u0434\u043E\u043D\u0438 \u043C\u043E\u043A\u0440\u044B\u0435,
      \u0432\u043E \u0440\u0442\u0443 \u043F\u0440\u0438\u0432\u043A\u0443\u0441
      \u0442\u043E\u043D\u0435\u0440\u0430."
    voice: {fileID: 0}
    autoAdvanceSeconds: 0
  - background: {fileID: 0}
    portrait: {fileID: 0}
    localizationTable: Office
    speakerKey: awakening.03.speaker
    textKey: awakening.03.text
    speaker: "\u0414\u0420\u0423\u0413 \u0417\u0410 \u0420\u0423\u041B\u0401\u041C"
    text: "\u041E\u0447\u0435\u0440\u0435\u0434\u044C \u043F\u043E\u0448\u043B\u0430.
      \u0413\u043E\u0442\u043E\u0432\u044C \u043F\u0430\u0441\u043F\u043E\u0440\u0442
      \u2014 \u0433\u0440\u0430\u043D\u0438\u0446\u0430 \u0447\u0435\u0440\u0435\u0437
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043C\u0438\u043D\u0443\u0442."
    voice: {fileID: 0}
    autoAdvanceSeconds: 0
